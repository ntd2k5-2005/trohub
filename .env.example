APP_NAME="TroHub"
APP_DISPLAY_NAME="TrọHub"
APP_TAGLINE="Tìm trọ dễ hơn. Quản lý gọn hơn. An toàn hơn."
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

VIETQR_DRIVER=quicklink
VIETQR_TEMPLATE=compact2
VIETQR_CLIENT_ID=
VIETQR_API_KEY=
LISTING_REVIEW_REQUIRED=false

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=database/database.sqlite
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@trohub.test"
MAIL_FROM_NAME="${APP_DISPLAY_NAME}"

VITE_APP_NAME="${APP_DISPLAY_NAME}"

APP_BRAND_PRIMARY="#5B5BD6"
APP_BRAND_ACCENT="#14B8A6"
SUPPORT_EMAIL=support@trohub.test
SUPPORT_PHONE="1900 0000"

FEATURE_IOT=true
FEATURE_ANALYTICS=false
FEATURE_ROOMMATE=true
FEATURE_ONLINE_PAYMENT=false
FEATURE_INTERNAL_CHAT=true

SUBSCRIPTION_TRIAL_DAYS=14
SUBSCRIPTION_ACCOUNT_AUTHORITY_ENABLED=true
SUBSCRIPTION_GRACE_DAYS=7

MONGODB_ENABLED=false
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=trohub
REDIS_ENABLED=false
REDIS_CLIENT=predis
REDIS_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CASSANDRA_ENABLED=false
CASSANDRA_HOST=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=trohub
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=
NEO4J_ENABLED=false
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_HTTP_URI=http://127.0.0.1:7474
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
BIGDATA_ENABLED=false
BIGDATA_ENDPOINT=

# Dang nhap Google / Facebook: chi bat sau khi dien credentials va migrate.
SOCIAL_LOGIN_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/auth/google/callback
SOCIAL_LOGIN_FACEBOOK_ENABLED=false
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=${APP_URL}/auth/facebook/callback
FACEBOOK_GRAPH_VERSION=v25.0
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

SOCIAL_LOGIN_SHOW_BUTTONS=false

EMAIL_AUTH_QUEUE=false

MAIL_TIMEOUT=10

# Gmail SMTP: tu dien email va App Password, khong dung mat khau dang nhap Gmail.
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=
# MAIL_FROM_NAME="${APP_NAME}"
# Port 587 dung STARTTLS; port 465 dung MAIL_SCHEME=smtps.
# Mailpit local: MAIL_HOST=127.0.0.1, MAIL_PORT=1025, credentials de trong.

# Optional listing index; the current public search page continues to use SQL.
MEILISEARCH_ENABLED=false
MEILISEARCH_HOST=http://127.0.0.1:7712
MEILISEARCH_KEY=
MEILISEARCH_INDEX=trohub_demo_v1_working_listings

# Set only in a private process when explicitly running the bounded demo importer.
TROHUB_DEMO_PASSWORD=
TROHUB_DEMO_DATE=2026-11-02

# Platform receiving account, supplied by the operator. Keep account numbers as strings.
PLATFORM_BANK_BIN=
PLATFORM_BANK_NAME=
PLATFORM_BANK_ACCOUNT_NUMBER=
PLATFORM_BANK_ACCOUNT_HOLDER=
